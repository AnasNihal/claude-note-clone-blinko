NEXTAUTH_URL=http://localhost:1111
NEXT_PUBLIC_BASE_URL=http://localhost:1111
NEXTAUTH_SECRET=my_ultra_secure_nextauth_secret
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5435/postgres

# AI Configuration - Pre-configured for demo purposes
# Note: Replace these with your actual API keys for production use
OPENAI_API_KEY=sk-demo-key-replace-with-real-key
ANTHROPIC_API_KEY=sk-ant-demo-key-replace-with-real-key
GOOGLE_AI_API_KEY=demo-google-key-replace-with-real-key

# Web Search Configuration (optional)
TAVILY_API_KEY=demo-tavily-key-replace-with-real-key

# AI Feature Flags - Enable all AI features by default
ENABLE_AI_FEATURES=true
ENABLE_AI_CHAT=true
ENABLE_AI_EMBEDDING=true
ENABLE_AI_TOOLS=true
ENABLE_WEB_SEARCH=true
